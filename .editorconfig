root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Plan files depend on tab indentation; keep trailing spaces (e.g. "- ", "| ").
[{*.planoptis,planoptis-demo-*.txt}]
indent_style = tab
trim_trailing_whitespace = false

[*.sublime-syntax]
indent_style = space
indent_size = 2
